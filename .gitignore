# Virtual environments
venv/
.venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/

# Environment / secrets
.env
.env.*
*.pem

# Jupyter
.ipynb_checkpoints/

